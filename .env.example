# Copy thành .env rồi điền giá trị. KHÔNG commit file .env lên Git.

# Pin version n8n để local và Render chạy giống nhau (ví dụ 1.x.y). Để trống = latest
N8N_VERSION=2.44.4

# Postgres (local)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=n8n

# Tạo bằng: openssl rand -hex 32
# KHÔNG ĐỔI sau khi đã tạo credential trong n8n
N8N_ENCRYPTION_KEY=

TIMEZONE=Asia/Ho_Chi_Minh

# ngrok: lấy ở https://dashboard.ngrok.com (Your Authtoken + Domains)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.app
